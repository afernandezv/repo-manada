---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | Manada Waingunga</title>
		<style>
			:root {
				/* Paleta basada en Dracula Theme con acento Lobato */
				--bg-main: #282a36;        /* Fondo oscuro principal */
				--bg-header: #1e1f29;      /* Fondo de la cabecera (más oscuro) */
				--bg-card: #44475a;        /* Fondo de las tarjetas */
				
				--text-main: #f8f8f2;      /* Texto principal claro */
				--text-muted: #8be9fd;     /* Subtítulos en cyan suave */
				
				--accent-yellow: #f1fa8c;  /* Amarillo Lobato / Dracula */
				--accent-pink: #ff79c6;    /* Rosa para etiquetas */
				
				--btn-bg: #6272a4;         /* Azul grisáceo para botones */
				--btn-hover: #bd93f9;      /* Morado al pasar el ratón */
				--border-color: #6272a4;
			}
			
			body {
				font-family: system-ui, -apple-system, sans-serif;
				background-color: var(--bg-main);
				color: var(--text-main);
				margin: 0;
				padding: 0;
			}
			
			header {
				background-color: var(--bg-header);
				padding: 2.5rem 1rem;
				text-align: center;
				border-bottom: 3px solid var(--accent-yellow);
			}
			
			.logo-manada {
				max-width: 130px; /* Ajusta este tamaño según tu logo */
				height: auto;
				margin-bottom: 1rem;
				filter: drop-shadow(0px 4px 6px rgba(0,0,0,0.5));
			}
			
			header a {
				text-decoration: none;
				color: var(--text-main);
			}
			
			header h1 {
				margin: 0;
				color: var(--accent-yellow);
				font-size: 2.2rem;
			}
			
			header p {
				color: var(--text-muted);
				margin-top: 0.5rem;
				font-size: 1.1rem;
			}
			
			main {
				max-width: 800px;
				margin: 2.5rem auto;
				padding: 0 1.5rem;
			}
			
			/* Enlaces generales para volver al inicio */
			main > a {
				color: var(--text-muted);
				text-decoration: none;
				font-weight: bold;
				display: inline-block;
				margin-bottom: 1.5rem;
			}
			
			main > a:hover {
				color: var(--accent-pink);
			}

			h2 {
				color: var(--text-main);
				border-bottom: 1px solid var(--border-color);
				padding-bottom: 0.5rem;
			}
			
			.card {
				background: var(--bg-card);
				padding: 1.8rem;
				border-radius: 10px;
				box-shadow: 0 8px 16px rgba(0,0,0,0.4);
				margin-bottom: 1.5rem;
				border: 1px solid var(--border-color);
				transition: transform 0.2s ease;
			}
			
			.card:hover {
				transform: translateY(-3px);
			}
			
			.card h3 {
				margin-top: 0;
				color: var(--accent-yellow);
			}
			
			/* Enlaces dentro de las tarjetas (como los títulos de la portada) */
			.card h3 a {
				color: var(--accent-yellow);
				text-decoration: none;
			}
			
			.card h3 a:hover {
				text-decoration: underline;
			}
			
			.btn {
				display: inline-block;
				background: var(--btn-bg);
				color: var(--text-main) !important;
				padding: 0.7rem 1.2rem;
				text-decoration: none !important;
				border-radius: 6px;
				font-weight: bold;
				margin-top: 1rem;
				transition: all 0.3s ease;
				border: none;
			}
			
			.btn:hover {
				background: var(--btn-hover);
				color: var(--bg-main) !important;
				box-shadow: 0 0 10px var(--btn-hover);
			}
			
			.tag {
				background: var(--bg-main);
				padding: 0.3rem 0.8rem;
				border-radius: 6px;
				font-size: 0.9rem;
				color: var(--accent-pink);
				border: 1px solid var(--border-color);
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<header>
			<a href="/">
				<!-- Aquí se manda llamar la imagen que subiste a la carpeta public -->
				<img src="/logo.png" alt="Logo de la Manada Waingunga" class="logo-manada" />
				
				<h1>Recursos - Manada Waingunga</h1>
				<p>Formatos, especialidades y manuales oficiales</p>
			</a>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>